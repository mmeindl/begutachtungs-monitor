[Unit]
Description=Begutachtungs-Monitor: probe the draft list every five minutes

[Timer]
# OnBootSec also starts the cycle on a box that has been up for weeks: a
# boot-relative time already in the past elapses the moment the timer is
# started (seen on the first deploy, 29.09.2026 18:21:08 — the run met the
# app mid-restart and stepped aside). After that, OnUnitActiveSec counts
# from each run.
OnBootSec=15min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
