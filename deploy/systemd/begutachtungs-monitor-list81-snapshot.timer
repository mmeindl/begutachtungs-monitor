# Installed by deploy/deploy.sh on every deploy.
#
# 05:10 UTC: after the RIS prewarm (04:30 + up to 20 min jitter), so the two
# never overlap, and far from Parliament's own sync — `lastSync` on list 81
# was minutes old whenever it was read, so no hour is the right one to wait
# for and any quiet hour does.
#
# Persistent=true catches up a run the server slept through — and ONLY that.
# It does not make the first snapshot happen at `enable --now`: with no stamp
# file yet, systemd takes the enable time as the last trigger and waits for the
# next slot (measured 25.09.2026, the timer sat a day idle). So whoever
# installs this timer takes the first snapshot by hand:
#
#   systemctl start begutachtungs-monitor-list81-snapshot.service
#
# Not done by deploy.sh on purpose: a snapshot per deploy would put a row in
# the series at a different hour than all the others, and comparing days is
# the whole point.
[Unit]
Description=Begutachtungs-Monitor: daily list-81 snapshot

[Timer]
OnCalendar=*-*-* 05:10:00 UTC
RandomizedDelaySec=10m
Persistent=true

[Install]
WantedBy=timers.target
